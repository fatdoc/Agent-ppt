# Separate production deployment. Never point these paths at the general edition.
APP_EDITION=education
LOAD_DOTENV=false
DATABASE_URL=sqlite:////srv/education/instance/education.db
UPLOAD_FOLDER=/srv/education/uploads
SECRET_KEY=replace-with-a-unique-random-secret
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true
FLASK_ENV=production
CORS_ORIGINS=https://education.example.com
BACKEND_PORT=5191
FRONTEND_PORT=3190
# Configure existing model and parsing providers for this deployment.
